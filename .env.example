# ============================================================
# AI Voice Calling Agent - Environment Variables Template
# Copy this to .env and fill in your actual values
# cp .env.example .env
# ============================================================

# ─── Telephony (Required) ───────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─── AI / LLM Provider (Choose one) ────────────────────────
AI_PROVIDER=groq   # groq | gemini | openai | huggingface

# Groq (Recommended - Fast & Cheap)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# OpenAI GPT (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ─── Speech-to-Text (STT) ───────────────────────────────────
STT_PROVIDER=huggingface   # huggingface (local Whisper) | assemblyai

# AssemblyAI (Cloud STT, optional)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Hugging Face ASR model (local Whisper)
HF_ASR_MODEL=openai/whisper-large

# ─── Text-to-Speech (TTS) ───────────────────────────────────
TTS_PROVIDER=huggingface   # huggingface (local) | elevenlabs | google | vibevoice

# ElevenLabs (Cloud TTS, optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Google Cloud TTS (optional)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/google-credentials.json

# Hugging Face Token (needed only for private models / Inference API)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=sqlite:///voice_agent.db
# For PostgreSQL: postgresql://user:password@host:5432/dbname

# ─── Server ─────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=False
PORT=5000
HOST=0.0.0.0
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.app

# ─── Call Settings ──────────────────────────────────────────
LANGUAGE_CODE=hi-IN
MAX_CALL_DURATION=300
